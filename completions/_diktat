#compdef diktat

# Everything here is read out of the binary rather than copied from it. A
# hand-kept list is a second source of truth, and it drifts: this file went on
# offering `record` and `transcribe` after both had left the tool.

# Commands come from `diktat --help`, whose listing is
# "  <name> <usage> <summary>" with the summary after a run of padding. Keying
# off the last run of two or more spaces means the column widths can change
# without breaking this.
_diktat_commands() {
    local -a commands
    commands=(${(f)"$(diktat --help 2>/dev/null | awk '
        /^  [a-z]/ {
            name = $1
            if (match($0, /.*  +/)) desc = substr($0, RLENGTH + 1)
            gsub(/:/, "\\:", desc)
            print name ":" desc
        }')"})
    _describe 'command' commands
}

# Model names come from `diktat model`, whose listing is a header row and then
# "[*>] <n> <name> <size> ...". A menu row is what starts with the marker column
# and a number, which the header and the trailing notes do not; a marker is
# there only for the model in use and the one being loaded, so it shifts the
# fields by one on those rows. Keying off which field is the number rather than
# off the marker itself means a new marker does not break this, as adding the
# one for a load in progress did.
# The number is right-aligned, so single digits carry a leading space.
_diktat_models() {
    local -a names
    names=(${(f)"$(diktat model 2>/dev/null | awk '/^[^ ]? +[0-9]+ /{print ($1 ~ /^[0-9]+$/) ? $2 : $3}')"})
    _describe 'model' names
}

# Pipelines come from `diktat tx-model`, and are offered by number rather than
# by name: an entry is called "parakeet-tdt-0.6b-v2 + sortformer", which is two
# words and needs quoting on the command line, where the number is what the
# menu is read for anyway. The name goes in the description.
#
# The table is followed by a blank line and then a note per entry, and a note
# line is the same shape as an unmarked menu row, so the blank line is where
# this stops rather than trying to tell prose from a pipeline.
#
# The name is taken as what lies between the number and the size, rather than
# as a column of a fixed width: a name longer than its column pushes every
# column after it along, and the longest entry here is longer than its column.
_diktat_tx_models() {
    local -a entries
    entries=(${(f)"$(diktat tx-model 2>/dev/null | awk '
        NR == 1 { next }
        NF == 0 { exit }
        {
            n = ($1 ~ /^[0-9]+$/) ? $1 : $2
            name = $0
            sub(/^.? *[0-9]+ +/, "", name)
            sub(/ +[0-9.]+ [KMG]iB.*$/, "", name)
            gsub(/:/, "\\:", name)
            print n ":" name
        }')"})
    _describe -V 'pipeline' entries
}

_diktat() {
    _arguments -C '1: :->command' '*:: :->args'

    case $state in
    command)
        _diktat_commands
        ;;
    args)
        case $words[1] in
        model)
            # One argument: the model to switch to, by name or by menu number.
            if (( CURRENT == 2 )); then
                _diktat_models
            fi
            ;;
        tx-model)
            if (( CURRENT == 2 )); then
                _diktat_tx_models
            fi
            ;;
        transcribe)
            # Any file ffmpeg reads, or a turns file from an earlier run, so
            # the recording is not filtered by extension.
            _arguments \
                '-o[write the transcript here]:path:_files' \
                '-timestamps[put the time of each turn in the document]' \
                '-model[pipeline to transcribe with]:pipeline:_diktat_tx_models' \
                '-diarizer[attribute speakers with this GGUF]:gguf:_files -g "*.gguf"' \
                '-lang[language of the recording, or "list"]:language:' \
                '-chunk[longest piece to transcribe at once]:duration:' \
                '*:recording:_files'
            ;;
        esac
        ;;
    esac
}

_diktat "$@"
