# Maintainer: see https://github.com/christian-oudard/diktat
pkgname=diktat
pkgver=1.0.0
pkgrel=1
pkgdesc="Voice dictation for Linux: hold a key, speak, and the text is typed where you are"
arch=('x86_64')
url="https://github.com/christian-oudard/diktat"
license=('MIT')

# The speech library is built from source and linked statically: there is no
# libtranscribe package to depend on, and one binary is a smaller promise to a
# user than two things with a version constraint between them.
_transcribe_commit=main

depends=(
  'espeak-ng'       # the warmup's synthesised speech
  'ffmpeg'          # decodes whatever `diktat transcribe` is handed
  'vulkan-icd-loader'
)
makedepends=('go' 'cmake' 'git' 'vulkan-headers' 'shaderc' 'glslang' 'pipewire' 'alsa-lib')
optdepends=(
  'wtype: typing on wlroots compositors (sway, Hyprland, river, wayfire, labwc, niri)'
  'ydotool: typing on GNOME and KDE, which do not implement the virtual-keyboard protocol'
  'xdotool: typing on X11'
  'wl-clipboard: the clipboard on Wayland, for the paste methods'
  'xclip: the clipboard on X11, for the paste methods'
  'sway: paste methods per application'
  'hyprland: paste methods per application'
)

source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "transcribe.cpp::git+https://github.com/christian-oudard/transcribe.cpp.git#branch=$_transcribe_commit"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$srcdir/transcribe.cpp"
  git submodule update --init --recursive
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # One recipe, shared with debian/rules and with anyone building by hand: it
  # reads the library's own link manifest to find out which archives and system
  # libraries the enabled backends need. See packaging/build.sh.
  TRANSCRIBE_SRC="$srcdir/transcribe.cpp" \
  BUILD_DIR="$srcdir/transcribe-build" \
  VERSION="$pkgver" \
  DIKTAT_REV="v$pkgver" \
  OUT="$srcdir/diktat" \
    sh packaging/build.sh
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # Everything that does not need a model, a microphone or a compositor.
  go test ./internal/...
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/diktat" "$pkgdir/usr/bin/diktat"
  install -Dm644 packaging/diktat.service "$pkgdir/usr/lib/systemd/user/diktat.service"
  install -Dm644 completions/_diktat "$pkgdir/usr/share/zsh/site-functions/_diktat"
  install -Dm644 packaging/diktat.1 "$pkgdir/usr/share/man/man1/diktat.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
